# Copy to swarm/.env (git-ignored), fill in YOUR values, then load with:
#   set -a; source swarm/.env; set +a
# and run scripts/deploy.sh. Never commit swarm/.env.
# NGINX_CONFIG_VERSION and TLS_VERSION are computed by scripts/deploy.sh.

# Images
SNIPPET_SERVICE_IMAGE="ghcr.io/ingsis-bry/snippet-service:<tag>"
PERMISSION_SERVICE_IMAGE="ghcr.io/ingsis-bry/snippet-permission-service:<tag>"
PRINTSCRIPT_UI_IMAGE="ghcr.io/ingsis-bry/printscript-ui:<tag>"

# snippet-service database (snippet-service-db)
SERVICE_POSTGRES_DB="<database-name>"
SERVICE_POSTGRES_USER="<database-user>"
SERVICE_POSTGRES_PASSWORD="<database-password>"

# snippet-permission-service database (snippet-permission-db)
PERMISSION_POSTGRES_DB="<database-name>"
PERMISSION_POSTGRES_USER="<database-user>"
PERMISSION_POSTGRES_PASSWORD="<database-password>"

# Blob Storage. Quoted because the value contains ';'.
# For the in-stack Azurite emulator use (Azurite's public, well-known default key):
# AZURE_STORAGE_CONNECTION_STRING="DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://azurite:10000/devstoreaccount1;"
AZURE_STORAGE_CONNECTION_STRING="<connection-string>"

# Auth0
AUTH0_DOMAIN="<tenant>.us.auth0.com"
AUTH0_AUDIENCE="https://snippet-searcher-api"
AUTH0_M2M_CLIENT_ID="<m2m-client-id>"
AUTH0_M2M_CLIENT_SECRET="<m2m-client-secret>"

# New Relic
NEW_RELIC_LICENSE_KEY="<new-relic-license-key>"

# TLS (paths on the machine running scripts/deploy.sh)
TLS_CERT_FILE="<path-to-fullchain.pem>"
TLS_KEY_FILE="<path-to-privkey.pem>"
