# Copy to azure-vm.env (git-ignored), fill in YOUR values, then load with:
#   set -a; source azure-vm.env; set +a
# Never commit azure-vm.env.

ENV=<dev|prod>
LOCATION=<azure-region>
VM_SIZE=<vm-size>
ADMIN_USER=<non-default-username>
SSH_KEY=<path-to-your-public-key.pub>
SSH_ALLOWED_IP=<your-public-ip>
NAME_SUFFIX=<random-5-chars>           # e.g. output of: openssl rand -hex 3

# Derived names (no need to edit)
RG=rg-snippet-$ENV-$NAME_SUFFIX
VNET=vnet-snippet-$ENV-$NAME_SUFFIX
SUBNET=subnet-snippet-$ENV-$NAME_SUFFIX
NSG=nsg-snippet-$ENV-$NAME_SUFFIX
PIP=pip-snippet-$ENV-$NAME_SUFFIX
NIC=nic-snippet-$ENV-$NAME_SUFFIX
VM=vm-snippet-$ENV-$NAME_SUFFIX
