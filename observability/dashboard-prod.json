{
  "name": "Snippet Searcher (prod)",
  "description": "Tráfico, latencia, errores, synthetic check y prueba de carga del entorno prod.",
  "permissions": "PUBLIC_READ_WRITE",
  "pages": [
    {
      "name": "Tiempo real",
      "description": null,
      "widgets": [
        {
          "title": "Requests por minuto (últimos 5 min)",
          "layout": {
            "column": 1,
            "row": 1,
            "width": 3,
            "height": 3
          },
          "linkedEntityGuids": null,
          "visualization": {
            "id": "viz.billboard"
          },
          "rawConfiguration": {
            "facet": {
              "showOtherSeries": false
            },
            "legend": {
              "enabled": true
            },
            "nrqlQueries": [
              {
                "accountIds": [
                  8743599
                ],
                "query": "SELECT rate(count(*), 1 minute) AS 'req/min' FROM Transaction WHERE appName = 'snippet-service-prod' SINCE 5 minutes ago"
              }
            ],
            "platformOptions": {
              "ignoreTimeRange": false
            }
          }
        },
        {
          "title": "Latencia p95 (últimos 5 min)",
          "layout": {
            "column": 4,
            "row": 1,
            "width": 3,
            "height": 3
          },
          "linkedEntityGuids": null,
          "visualization": {
            "id": "viz.billboard"
          },
          "rawConfiguration": {
            "facet": {
              "showOtherSeries": false
            },
            "legend": {
              "enabled": true
            },
            "nrqlQueries": [
              {
                "accountIds": [
                  8743599
                ],
                "query": "SELECT percentile(duration * 1000, 95) AS 'p95 ms' FROM Transaction WHERE appName = 'snippet-service-prod' SINCE 5 minutes ago"
              }
            ],
            "platformOptions": {
              "ignoreTimeRange": false
            }
          }
        },
        {
